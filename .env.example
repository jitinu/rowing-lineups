# Supabase project URL and keys (Project Settings > API). Local defaults from `supabase start` shown.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by scripts/seed.ts and tests/db. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection used by RLS tests.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
